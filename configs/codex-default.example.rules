# ~/.codex/rules/default.rules
# 物理门禁：拦截包管理器的安装与升级命令，强制要求先说明原因与影响范围
prefix_rule(pattern=["npm", "install"], decision="prompt", justification="新增或升级依赖前，请先说明原因（为何已有实现与标准库不够用）和影响，获得确认后再执行")
prefix_rule(pattern=["npm", "i"], decision="prompt", justification="新增或升级依赖前，请先说明原因（为何已有实现与标准库不够用）和影响，获得确认后再执行")
